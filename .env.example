# OpenTelemetry Configuration
# These environment variables configure the OpenTelemetry instrumentation

# OTLP Endpoint - The endpoint where telemetry data will be sent
# For Vite/client-side apps, use VITE_ prefix to make it available in the browser
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# OTLP Bearer Token - Authentication token for the OTLP endpoint
# For Vite/client-side apps, use VITE_ prefix to make it available in the browser
VITE_OTEL_EXPORTER_OTLP_BEARER_TOKEN=your_bearer_token_here
OTEL_EXPORTER_OTLP_BEARER_TOKEN=your_bearer_token_here

# OpenTelemetry Sampling Rate (0.0 to 1.0)
# Controls what percentage of traces are sampled
VITE_OTEL_SAMPLING_RATE=1.0

# Application Configuration
# Service name for OpenTelemetry resource attributes
VITE_SERVICE_NAME=hoops-analytics-viz

# Supabase Configuration (if using Supabase for OTEL config)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
